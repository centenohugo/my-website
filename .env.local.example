POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
ADMIN_PASSWORD=

# Public origin of the deployed site, no trailing slash (e.g. https://example.com).
# Used for canonical URLs, Open Graph tags, the sitemap and JSON-LD. Falls back to
# http://localhost:3000, so it MUST be set in production — an unset value would
# publish localhost canonicals.
NEXT_PUBLIC_SITE_URL=

# Spanish translation (see lib/translate.ts)
OPENROUTER_API_KEY=
# Optional. Comma-separated, tried in order when one is rate-limited or
# retired; blank uses the built-in chain in lib/translate.ts.
OPENROUTER_MODEL=
